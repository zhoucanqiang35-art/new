{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pikobuyspreadsheet-my-id",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
