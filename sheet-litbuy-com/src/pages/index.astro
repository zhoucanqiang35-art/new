---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import AllProductBrowser from '../components/AllProductBrowser.astro';
const categories = [
  ['All Products', ''], ['ShortSets', 'ShortSets'], ['Shoes', 'shoes'], ['Accessories', 'accessories'], ['Hoodies Sweaters', 'hoodies-sweaters'],
  ['Pants Shorts', 'pants-shorts'], ['Electronics', 'electronics'], ['T Shirts', 't-shirts'], ['Jackets', 'jackets'], ['Headwear', 'headwear'],
];
const faqs = [
  ['01 · Product links', 'Paste Taobao, Weidian or 1688 links in LitBuy’s live search flow; retain the source ID, chosen option and date checked.'],
  ['02 · USD prices', 'CNY is the source reference. The USD amount is a browsing estimate, not a final payment or parcel quote.'],
  ['03 · QC photos', 'Warehouse photos can help check visible colour, label or quantity, but cannot prove fit, authenticity or delivery outcomes.'],
  ['04 · Storage', 'LitBuy describes storage and combined shipping. Check the current order status and live storage notice before relying on a deadline.'],
  ['05 · Parcel decisions', 'Route eligibility depends on destination, contents, dimensions and current restrictions. Check the live parcel screen before submission.'],
  ['06 · Tracking & returns', 'Keep order and parcel identifiers. Current carrier status and official policy are the references for a shipment or after-sales question.'],
];
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Browse LitBuy product sheets, source photos and USD estimates from FindSpreadsheet." /><title>Sheet LitBuy — Browse Product Sheets</title><link rel="icon" href="/assets/litbuy-flame.png" /></head><body><SiteNav active="home" /><main>
  <section class="intro intro-without-image"><div class="intro-copy"><p class="eyebrow">INDEPENDENT PRODUCT RESEARCH</p><h1>Browse LitBuy product sheets before you click.</h1><p>Search current source records, compare a USD-first view and inspect available media before continuing to LitBuy.</p><div class="intro-buttons"><a href="#catalog">Browse all products <b>→</b></a><a href="/seo-articles/">Read guides <b>→</b></a></div></div></section>
  <section class="categories"><div class="section-title"><p class="eyebrow">EXPLORE THE CATALOGUE</p><h2>Browse by category</h2></div><div class="category-grid">{categories.map(([name, slug], index) => <a href={slug ? '/categories/?category=' + encodeURIComponent(slug) + '#all-products' : '/categories/#all-products'}><i>{String(index + 1).padStart(2,'0')}</i><span>{name}</span><b>→</b></a>)}</div></section>
  <section id="catalog" class="evidence"><div class="section-head"><div><p class="eyebrow">COMPLETE FINDSHEETSPREADSHEET EXPORT</p><h2>All Product Sheets</h2><p>All source records are presented inside this site. The first page is a compact 6 × 10 grid; search and internal pagination expose the remaining products.</p></div><a class="view-all" href="/categories/#all-products">All categories <b>→</b></a></div><div class="finder"><div><label for="q">Search product sheets</label><input id="q" type="search" placeholder="Search title, category or source ID" /></div><div><label for="promo-link">Check a LitBuy / Weidian link</label><div class="link-input"><input id="promo-link" type="url" placeholder="Paste product link" /><button id="match-link" type="button">Check</button></div></div><div class="upload"><label for="image-upload">Image reference</label><input id="image-upload" type="file" accept="image/*" /><span>Upload <b>+</b></span><div id="upload-result" hidden></div></div></div><p id="result-count" class="count">Loading full FindSpreadsheet catalogue…</p><AllProductBrowser perPage={60} sixColumns /></section>
  <section class="trust"><div class="section-title"><p class="eyebrow">HOW WE WORK</p><h2>Research before marketing.</h2><p>Every product record keeps its source ID, image path, category and source price reference. No local substitute catalogue is used.</p></div><div class="trust-grid"><article><i>01</i><h3>Evidence-led</h3><p>Browse visible record details and inspect source media carefully.</p></article><article><i>02</i><h3>Internal discovery</h3><p>Categories, search and product details remain in this subsite.</p></article><article><i>03</i><h3>USD first</h3><p>Use the estimate for comparison, then confirm the live final amount.</p></article><article><i>04</i><h3>Source aware</h3><p>Product data remains supplied by FindSpreadsheet.</p></article></div></section>
  <section class="guides"><div class="section-head"><div><p class="eyebrow">START HERE</p><h2>Useful product-sheet guides</h2><p>Practical research notes before a first purchasing-route click.</p></div></div><div class="guide-grid"><article><span>Guide 01</span><div class="guide-art">⌁</div><h3>Read a product sheet</h3><p>Compare a source title, ID, price and image before opening an order route.</p><a href="/seo-articles/">Read guide <b>→</b></a></article><article><span>Guide 02</span><div class="guide-art art-1">⌁</div><h3>Use QC evidence carefully</h3><p>What images can help you inspect — and what they cannot guarantee.</p><a href="/seo-articles/#article-2">Read guide <b>→</b></a></article><article><span>Guide 03</span><div class="guide-art art-2">⌁</div><h3>Understand USD estimates</h3><p>Why the CNY source price remains visible next to the browse estimate.</p><a href="/faq/">Read guide <b>→</b></a></article></div></section>
  <section class="faq home-faq"><div class="section-head"><div><p class="eyebrow">FREQUENTLY ASKED QUESTIONS</p><h2>Six things to know first.</h2><p>A scan-friendly overview of product links, QC, storage and parcel decisions. Full answers remain available on the dedicated FAQ page.</p></div><a class="view-all" href="/faq/">View all answers <b>→</b></a></div><div class="home-faq-grid">{faqs.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}</div></section>
  <section class="contact"><div><p class="eyebrow">PRODUCT RESEARCH</p><h2>See the source.<br />Then decide.</h2></div><p>Use LitBuy only when you are ready to open a product route or create an account.</p><a href="https://litbuy.com/register?inviteCode=E32JME4UQ" rel="noreferrer">Create LitBuy account ↗</a></section>
</main><footer><div class="footer-brand"><span>SL</span><b>sheet litbuy</b><p>Independent product discovery for shoppers reading product sheets.</p></div><div><h3>Navigate</h3><a href="/categories/">Product Categories</a><a href="/product-details/">Product Details</a><a href="/seo-articles/">SEO Articles</a><a href="/faq/">FAQ</a></div><div><h3>Source</h3><span>FindSpreadsheet catalogue data</span><span>USD browsing estimate shown per record</span></div><small>Not affiliated with LitBuy, Weidian, or sellers. Confirm details and final payment on the destination platform.</small></footer>
<style is:global>
  .home-faq{padding-top:72px;padding-bottom:78px}.home-faq .section-head{max-width:1140px;margin:0 auto 27px}.home-faq-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;max-width:1140px;margin:auto}.home-faq-grid article{padding:21px;border:1px solid var(--line);border-radius:8px;background:#fff}.home-faq-grid h3{margin:0 0 10px;color:var(--ink);font-size:16px;letter-spacing:-.025em}.home-faq-grid p{margin:0;color:var(--sub);font-size:13px;line-height:1.68}@media(max-width:740px){.home-faq-grid{grid-template-columns:1fr;padding:0 18px}.home-faq .section-head{padding:0 18px}.home-faq{padding-top:54px;padding-bottom:58px}}
</style>
<script>const q=document.querySelector('#q');const inner=document.querySelector('[data-catalogue-search]');const count=document.querySelector('#result-count');const search=(value='')=>{if(!inner)return;inner.value=value;inner.dispatchEvent(new Event('input'));count.textContent=value?'Showing internal results for “'+value+'”.':'All source products are available through internal pagination.'};q?.addEventListener('input',()=>search(q.value));document.querySelector('#match-link')?.addEventListener('click',()=>{const field=document.querySelector('#promo-link');const id=field.value.match(/(?:weidian\/|product\/)(\d{5,})/)?.[1]||field.value.match(/\b(\d{5,})\b/)?.[1];if(id){q.value=id;search(id)}else count.textContent='Paste a LitBuy or Weidian URL containing a numerical product ID.'});const upload=document.querySelector('#image-upload');const output=document.querySelector('#upload-result');upload?.addEventListener('change',()=>{const file=upload.files?.[0];if(!file)return;output.hidden=false;output.innerHTML='<img src="'+URL.createObjectURL(file)+'" alt="Local reference preview"><small>Local preview only. No image match is claimed.</small>'});</script></body></html>
