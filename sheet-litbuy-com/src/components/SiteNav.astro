---
const { active = '' } = Astro.props;
const registerUrl = 'https://litbuy.com/register?inviteCode=E32JME4UQ';
---
<header class="nav">
  <a class="wordmark flame-link" href={registerUrl} rel="noreferrer" aria-label="Register with LitBuy using invite code E32JME4UQ"><span class="flame-crop"><img src="/assets/litbuy-flame.png?v=wordmark-20261022" alt="LitBuy" width="131" height="34" /></span></a>
  <nav aria-label="Primary">
    <a class={active === 'home' ? 'active' : ''} href="/">Home</a>
    <a class={active === 'categories' ? 'active' : ''} href="/categories/">Product Categories</a>
    <a class={active === 'detail' ? 'active' : ''} href="/product-details/">Product Details</a>
    <a class={active === 'seo' ? 'active' : ''} href="/seo-articles/">SEO Articles</a>
    <a class={active === 'faq' ? 'active' : ''} href="/faq/">FAQ</a>
  </nav>
  <div class="nav-actions">
    <details class="languages"><summary><span>Language</span> · <b data-current-language>EN</b></summary><div><a href="?lang=en" data-language-option="en">English</a><a href="?lang=de" data-language-option="de">Deutsch</a><a href="?lang=fr" data-language-option="fr">Français</a><a href="?lang=es" data-language-option="es">Español</a><a href="?lang=it" data-language-option="it">Italiano</a><a href="?lang=pt" data-language-option="pt">Português</a><a href="?lang=nl" data-language-option="nl">Nederlands</a><a href="?lang=pl" data-language-option="pl">Polski</a><a href="?lang=sv" data-language-option="sv">Svenska</a></div></details>
    <a class="register" href={registerUrl} rel="noreferrer">Register ↗</a>
  </div>
</header>
<script is:inline src="/scripts/site-i18n.js"></script>
<script is:inline src="/scripts/site-i18n-full.js"></script>
<style is:global>
  :root{--ink:#f9f5ff;--sub:#c9bddd;--blue:#ffd20a;--pale:#1c0a3b;--line:#4f247f;--warm:#ff7900;--white:#fff}
  body{background:#11051f;color:var(--ink)}.nav{max-width:none;height:58px;gap:14px;padding:0 max(18px,calc((100vw - 1160px)/2));background:#ffd20a;color:#18062b}.nav .wordmark{flex:0 0 auto;gap:0}.nav .wordmark>span.flame-crop{display:block;width:131px;height:34px;overflow:visible;background:transparent}.flame-crop img{display:block;width:131px!important;max-width:none!important;height:34px!important}.nav nav{display:flex;flex:0 1 auto;gap:12px}.nav nav a{font-size:9px;white-space:nowrap}.nav nav a.active,.languages summary{color:#4b1476}.nav-actions{display:flex;flex:0 0 auto;align-items:center;gap:9px;margin-left:auto}.register{padding:8px 9px;border-radius:999px;background:#18062b;color:#fff;text-decoration:none;font-size:9px;font-weight:900}.languages{position:relative}.languages summary{list-style:none;cursor:pointer;font-size:9px;font-weight:800;white-space:nowrap}.languages summary::-webkit-details-marker{display:none}.languages[open]>div{position:absolute;z-index:10;right:0;top:22px;display:grid;grid-template-columns:1fr 1fr;min-width:184px;gap:1px;padding:7px;border:1px solid var(--line);border-radius:5px;background:#1b0936;color:#fff;box-shadow:0 10px 25px #0008}.languages a{padding:7px;text-decoration:none;font-size:10px;font-weight:700}.languages a:hover{background:#351061}.intro-without-image{grid-template-columns:1fr;min-height:0;padding-top:66px;padding-bottom:69px;background:radial-gradient(circle at 75% 5%,#6520a8 0,transparent 27%),linear-gradient(130deg,#10031e 0%,#210945 54%,#11051f 100%)}.intro-without-image .intro-copy{width:min(640px,100%);margin-left:auto;margin-right:auto}.intro-without-image .intro-copy>p:not(.eyebrow){max-width:580px}.categories,.trust,.faq{background:#1b0838}.evidence,.guides{background:#11051f}.intro-buttons a{background:#ffd20a;color:#1a092d}.intro-buttons a+ a{background:#31105d;color:#fff}.guide-art{background:#351061;color:#ffd20a}.art-1{background:#4b1476;color:#ffd20a}.art-2{background:#2b0c53;color:#ff7900}.contact{background:linear-gradient(115deg,#ff7900,#ffd20a);color:#1b0930}.contact .eyebrow{color:#45106c}.contact>p{color:#3b1558}.contact a{background:#17052b;color:#fff}.category-grid>a,.category-page a,.catalogue-product-card,.home-faq-grid article,.guide-grid article,.article-list article{background:#250b4c;color:#fff;border-color:#4f247f}.category-grid>a i,.category-page a i{color:#cdb5ed}.category-grid>a b,.category-page a b,.catalogue-product-body p,.catalogue-card-footer a{color:#ffd20a}.finder{background:#210944;border-color:#4f247f}.finder>div{border-color:#4f247f}.finder input,.catalogue-controls input,.catalogue-pagination button{background:#130625;color:#fff;border-color:#4f247f}.thumb,.catalogue-product-image,.main-media,.media-strip{background:#1a0734}.detail-page,.subpage{background:#11051f}.detail-info h1,.detail-card h2,.subpage h1,.long-article h2{color:#fff}.detail-info>p:not(.eyebrow),.detail-card p:not(.eyebrow),.subpage .lead,.media-label span,.qc-empty{color:#c9bddd}.primary-link{background:#ffd20a;color:#1b092e}.qc-thumbs button{background:#1b0938;border-color:#4f247f}.qc-thumbs button.selected{border-color:#ffd20a;box-shadow:0 0 0 2px #ffd20a33}.continuous-media{border-color:#4f247f}.home-faq-grid p,.trust-grid p,.guide-grid p{color:#c9bddd}.home-faq-grid h3,.trust-grid h3,.guide-grid h3{color:#fff}.contact h2{color:#1b092e}footer{background:#090212;color:#d8caee}footer a,footer span,.footer-brand p{color:#d8caee}footer h3,.footer-brand{color:#fff}
  @media(max-width:980px){.nav nav{display:none}.mini-records{grid-template-columns:repeat(2,1fr)}.detail-top{grid-template-columns:1fr;gap:29px}.detail-info{max-width:620px}}
  @media(max-width:600px){.nav{height:54px;padding:0 14px}.nav .wordmark>span.flame-crop,.flame-crop img{width:112px!important}.nav-actions{gap:7px}.languages{display:none}.register{font-size:9px;padding:8px 9px}.intro-without-image{padding:30px 18px 34px}.intro h1{font-size:32px}.intro-copy>p:not(.eyebrow){margin:14px 0;font-size:13px}.categories,.evidence,.trust,.guides,.faq,.contact{padding:30px 18px}.category-grid{grid-template-columns:repeat(5,minmax(112px,1fr));gap:7px;overflow-x:auto;padding-bottom:3px}.category-grid>a,.category-page a{min-height:68px;padding:9px}.category-grid>a span,.category-page a span{font-size:10px}.section-title h2,.section-head h2{font-size:27px}.trust,.faq{grid-template-columns:1fr;gap:18px}.trust-grid{grid-template-columns:repeat(2,1fr);gap:13px}.trust-grid h3{margin:5px 0;font-size:12px}.trust-grid p{font-size:10px}.guide-grid,.home-faq-grid{display:flex;overflow-x:auto;gap:10px;padding-bottom:4px}.guide-grid article,.home-faq-grid article{min-width:210px}.guide-art{height:70px;margin:8px 0;font-size:34px}.guide-grid p{min-height:0;font-size:11px}.home-faq{padding-top:30px!important;padding-bottom:30px!important}.home-faq .section-head{padding:0!important;margin-bottom:15px}.home-faq-grid{padding:0!important}.home-faq-grid article{padding:14px}.home-faq-grid h3{font-size:13px}.home-faq-grid p{font-size:11px;line-height:1.45}.contact{grid-template-columns:1fr;gap:15px}.contact h2{font-size:30px}.contact>p{font-size:12px}.subpage,.detail-page{padding:34px 18px 46px}.detail-card{grid-template-columns:1fr;gap:25px}.mini-records{grid-template-columns:repeat(2,1fr)}.detail-top{padding-bottom:38px}.media-label{display:block}.media-label span{display:block;margin-top:10px}}
</style>
<style is:global>
  /* The language menu needs an unclipped header.  The earlier full-bleed
     clip-path cut off an absolutely-positioned menu as soon as it opened. */
  @media (min-width:981px){.nav{max-width:1160px;margin:0 auto;padding:0 18px;box-shadow:0 0 0 100vmax #ffd20a;clip-path:none;overflow:visible}}
</style>
<style is:global>
  /* Keep every standalone route as a centred reading frame rather than a full-width canvas. */
  .subpage,.detail-page{width:100%;max-width:1190px;margin-right:auto;margin-left:auto;padding:58px 26px 82px}
  .subpage.editorial,.faq-page{max-width:1190px!important;margin-right:auto;margin-left:auto}
  .category-directory{background:#11051f!important}
  .faq-page .faq-topic,.faq-page .faq-answer-card,.faq-page .faq-boundary{color:#111}
  .faq-page .faq-topic h2,.faq-page .faq-answer-card h3,.faq-page .faq-answer-card p,.faq-page .faq-boundary,.faq-page .faq-boundary strong{color:#111!important;font-family:Arial,Helvetica,sans-serif;font-weight:700}
  /* One durable product-detail frame for both the client-rendered catalogue route
     and every generated /products/:id route.  The product facts deliberately
     live in their own visible column, so media sizing can never push title, ID,
     price or the purchase action out of the layout. */
  .detail-page{min-width:0}
  .detail-page .back-link{display:inline-flex;margin:0 0 18px;color:#fff;font-size:13px;font-weight:800;text-decoration:underline;text-underline-offset:3px}
  .detail-top{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(330px,.72fr);align-items:start;gap:34px;padding:0 0 42px;border-bottom:1px solid #4f247f}
  .detail-media{display:grid;min-width:0;gap:12px}
  .main-media{display:grid;min-height:300px;overflow:hidden;border:1px solid #4f247f;background:#1a0734}
  .main-media img{display:block;width:100%;height:auto;max-height:680px;object-fit:contain;background:#fff}
  .qc-thumbs{display:flex;min-width:0;gap:9px;overflow-x:auto;padding:2px 2px 7px;scroll-snap-type:x proximity}
  .qc-thumbs button{display:block;flex:0 0 104px;overflow:hidden;padding:0;border:2px solid #4f247f;cursor:pointer;scroll-snap-align:start}
  .qc-thumbs button img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}
  .qc-empty{margin:0;padding:13px;border:1px dashed #6a438e;font-size:12px;line-height:1.55}
  .detail-info{display:block;min-width:0;padding:25px;border:1px solid #4f247f;background:#250b4c;box-shadow:0 16px 32px #05000f42}
  .detail-info .eyebrow{margin:0 0 13px;color:#ffd20a;font-size:10px;line-height:1.55;overflow-wrap:anywhere}
  .detail-info h1{display:block;margin:0 0 22px;color:#fff;font-size:clamp(25px,2.8vw,41px);line-height:1.06;letter-spacing:-.055em;overflow-wrap:anywhere}
  .detail-price{display:grid;gap:5px;margin:0 0 19px;padding:17px 0;border-top:1px solid #5f328c;border-bottom:1px solid #5f328c}
  .detail-price strong{color:#ffd20a;font-size:27px;line-height:1;letter-spacing:-.045em}
  .detail-price span{color:#e0d2f1;font-size:12px;font-weight:700;line-height:1.45}
  .detail-info>p:not(.eyebrow){display:block;margin:0 0 21px;color:#e0d2f1;font-size:13px;line-height:1.65}
  .primary-link{display:flex;align-items:center;justify-content:center;min-height:45px;padding:12px 16px;color:#1b092e!important;font-size:13px;font-weight:950;text-decoration:none}
  .primary-link:hover{filter:brightness(1.07)}
  .continuous-media{display:block;min-width:0;margin:0;padding:37px 0 0;border:0}
  .media-label{display:flex;align-items:end;justify-content:space-between;gap:22px;margin:0 0 17px}
  .media-label .eyebrow{margin:0 0 7px;color:#ffd20a}
  .media-label h2{margin:0;color:#fff;font-size:25px;letter-spacing:-.035em}
  .media-label span{max-width:390px;font-size:12px;line-height:1.5;text-align:right}
  /* The stream is a single uninterrupted column: Weidian originals first,
     then product-owned QC photos, all kept at their native aspect ratio. */
  .media-strip{display:grid;gap:0;overflow:hidden;border:1px solid #4f247f}
  .media-strip img{display:block;width:100%;height:auto;margin:0;background:#fff}
  @media(max-width:980px){.detail-top{grid-template-columns:1fr;gap:24px}.detail-info{max-width:none}.main-media img{max-height:760px}.media-label{align-items:start;flex-direction:column;gap:5px}.media-label span{text-align:left}}
  @media(max-width:600px){.subpage,.detail-page{width:100%;padding:34px 18px 46px}.subpage.editorial{width:100%}}
  @media(max-width:600px){.detail-page .back-link{margin-bottom:15px;font-size:12px}.detail-top{gap:18px;padding-bottom:28px}.main-media{min-height:180px}.qc-thumbs{gap:7px}.qc-thumbs button{flex-basis:78px}.detail-info{padding:19px}.detail-info h1{font-size:28px}.detail-price strong{font-size:25px}.continuous-media{padding-top:27px}.media-label h2{font-size:21px}}
</style>
