<style is:global>
  /* A single vertical language list keeps every available locale readable.
     The supported locales stay unchanged so each choice still has a complete
     in-site translation, instead of exposing an unfinished tenth locale. */
  .languages[open]>div{display:grid!important;grid-template-columns:minmax(0,1fr)!important;grid-auto-rows:minmax(34px,auto)!important;gap:2px!important;min-width:172px!important;padding:6px!important;overflow:visible!important}
  .languages[open] a{display:flex!important;align-items:center!important;padding:8px 10px!important;color:#3d2a1f!important;font-size:12px!important;line-height:1.2!important;white-space:nowrap!important;border-radius:3px!important}
  @media(min-width:801px){.nav{clip-path:none!important;overflow:visible!important}.languages[open]>div{top:30px!important;z-index:1000!important}}
</style>
