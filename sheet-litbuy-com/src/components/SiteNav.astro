  .thumb,.catalogue-product-image,.main-media,.media-strip{background:#eff3e7!important}.catalogue-product-body h2,.catalogue-product-body strong{color:#3d2a1f!important}.catalogue-product-body small,.catalogue-controls label,.catalogue-controls p,.catalogue-pagination span{color:#705d50!important}
  .guide-art{background:#dfeacb!important;color:#52742d!important}.art-1{background:#eee5d6!important;color:#765332!important}.art-2{background:#d9e6c5!important;color:#4d6d2a!important}.guide-grid p,.home-faq-grid p,.trust-grid p{color:#705d50!important}.guide-grid h3,.home-faq-grid h3,.trust-grid h3{color:#3d2a1f!important}
  .contact{background:linear-gradient(125deg,#3d2a1f,#6f9638)!important;color:#fff!important}.contact .eyebrow,.contact>p{color:#eef5e4!important}.contact a{background:#fffdf8!important;color:#3d2a1f!important}
  .detail-page .back-link{color:#6f9638!important}.detail-top{border-color:#ced9bd!important}.main-media{border-color:#ced9bd!important}.qc-thumbs button{background:#eff3e7!important;border-color:#ced9bd!important}.qc-thumbs button.selected{border-color:#6f9638!important;box-shadow:0 0 0 2px #6f96382b!important}.qc-empty{color:#705d50!important;border-color:#a9bb91!important}.detail-info{background:#fffdf8!important;border-color:#ced9bd!important;box-shadow:0 16px 32px #3d2a1f12!important}.detail-info .eyebrow,.detail-price strong,.media-label .eyebrow{color:#6f9638!important}.detail-price{border-color:#d9e3ca!important}.detail-price span,.detail-info>p:not(.eyebrow),.media-label span{color:#705d50!important}.media-label h2{color:#3d2a1f!important}.media-strip{border-color:#ced9bd!important}
  .article-index,.keyword-line,.editor-note{background:#eff3e7!important;border-color:#ced9bd!important;color:#3d2a1f!important}.article-index a{color:#6f9638!important}.long-article{border-color:#ced9bd!important}.long-article h3{color:#3d2a1f!important}.long-article section p,.article-dek{color:#705d50!important}.keyword-line{border-left-color:#6f9638!important}
  .faq-page .faq-topic,.faq-page .faq-answer-card{background:#fffdf8!important;border-color:#ced9bd!important}.faq-page .faq-boundary{background:#e8f0da!important}.faq-jump a{background:#fffdf8!important;border-color:#ced9bd!important;color:#3d2a1f!important}.faq-jump a:hover{border-color:#6f9638!important;color:#6f9638!important}
  footer{background:#2c1c13!important;color:#f0eadf!important}footer a,footer span,.footer-brand p{color:#ded2c1!important}footer h3,.footer-brand{color:#fff!important}
</style>
