const registerUrl = 'https://litbuy.com/register?inviteCode=E32JME4UQ';
const navItems = [['Home', '/'], ['Product categories', '/categories/'], ['SEO articles', '/seo-articles/'], ['Product finds', '/product-finds/'], ['QC guide', '/qc-guide/'], ['FAQ', '/faq/']];
