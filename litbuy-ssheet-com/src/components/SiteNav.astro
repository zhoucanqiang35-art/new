const editorialEditionsScript = `window.__litbuyEditorial=${JSON.stringify(editorialEditions)};`;
---
<header class="finder-nav">
  <a class="finder-brand" href="/" aria-label="LitBuy Spreadsheet home"><span class="official-mark"><img src="/assets/logo-Litbuy-2.png" alt="" /></span><strong>LITBUY</strong></a>
  <nav aria-label="Primary navigation">{navItems.map(([label, href]) => <a href={href} data-l10n={label}>{label}</a>)}</nav>
  <div class="nav-actions">
    <details class="language-menu" data-language-menu>
      <summary class="nav-language"><span data-l10n="Language">Language</span> <b data-current-language>EN</b><i aria-hidden="true">⌄</i></summary>
      <div class="language-popover" role="menu"><p data-l10n="Choose language">Choose language</p><div>{languages.map(([code, label, locale]) => <a href={`?lang=${locale}`} data-language-option={locale} role="menuitem"><b>{code}</b><span>{label}</span></a>)}</div></div>
    </details>
    <a class="nav-register" href={registerUrl} target="_blank" rel="noreferrer"><span data-l10n="Register">Register</span> <b>↗</b></a>
  </div>
</header>

