      }
    };

    const setLanguageLinks = root => {
      root.querySelectorAll?.('a[href^="/"]:not([data-language-option])').forEach(a => {
        const u = new URL(a.href, location.origin);
        u.searchParams.set('lang', lang);
        a.href = u.pathname + u.search + u.hash;
      });
      root.querySelectorAll?.('form[action^="/"]').forEach(form => {
        let input = form.querySelector('input[name="lang"]');
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.name = 'lang';
          form.append(input);
        }
        input.value = lang;
      });
    };
    const replaceExactLabels = root => {
      if (lang === 'en') return;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: node => !node.nodeValue.trim() || node.parentElement.closest('script,style,[data-source-content]') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT
      });
      const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
      nodes.forEach(node => {
        const key = node.nodeValue.trim().replace(/\s+/g, ' ');
        const value = words[key] || runtimeLabels[lang]?.[key] || fixedContent[lang]?.[key] || sharedPageCopy[key]?.[localeIndex] || homeCopy[key]?.[localeIndex] || categoryNames[key]?.[localeIndex];
        if (value) node.nodeValue = node.nodeValue.replace(key, value);
      });
      root.querySelectorAll?.('[data-l10n]').forEach(node => {
        const value = words[node.dataset.l10n];
        if (value) node.textContent = value;
      });
    };
    const setReviewedIntro = () => {
      if (lang === 'en' || !intros[document.body.dataset.page]) return;
      const values = intros[document.body.dataset.page][localeIndex];
      const root = document.body.dataset.page === 'home' ? document.querySelector('.catalog-start-title') : document.querySelector('.inner-intro');
      if (!root || !values) return;
      const eyebrow = root.querySelector('.eyebrow') || root.querySelector('p');
      if (eyebrow) eyebrow.textContent = values[0];
      root.querySelector('h1').textContent = values[1];
      const copy = document.body.dataset.page === 'home' ? root.querySelector('span') : [...root.querySelectorAll('p')].find(node => node !== eyebrow);
      if (copy) copy.textContent = values[2];
    };
    const apply = root => {
      document.documentElement.lang = lang;
      document.body.dataset.locale = lang;
      localStorage.setItem('litbuy-language', lang);
      window.litbuyLocale = lang;
      document.querySelectorAll('[data-current-language]').forEach(node => node.textContent = words.code);
      document.querySelectorAll('[data-language-option]').forEach(node => {
        const u = new URL(location.href);
        u.searchParams.set('lang', node.dataset.languageOption);
        node.href = u.pathname + u.search;
        node.onclick = () => localStorage.setItem('litbuy-language', node.dataset.languageOption);
      });
      replaceExactLabels(root);
      setLanguageLinks(root);
    };
    // Public hook for pages that build catalogue cards after the initial render.
    // It deliberately has the same exact-string policy as the initial pass.
    window.litbuyTranslateContent = root => {
      if (!root) return;
      replaceExactLabels(root);
      setLanguageLinks(root);
    };
    const start = () => {
      apply(document);
      setReviewedIntro();
      document.dispatchEvent(new CustomEvent('litbuy:localechange', { detail: { locale: lang } }));
      // Catalogue, search and product pages add records after the first render.
      // Propagate the selected locale to those internal routes too.
      new MutationObserver(records => records.forEach(record => {
        record.addedNodes.forEach(node => {
          if (node.nodeType === Node.ELEMENT_NODE) apply(node);
        });
      })).observe(document.body, {childList: true, subtree: true});
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, {once: true}); else start();
  })();
</script>
<script is:inline set:html={editorialEditionsScript}></script>
<script is:inline>
  /*
    These editions are generated at build time using local translation models.
    Each source paragraph has exactly one matching translated paragraph.  This
    deliberately replaces text in place: it never appends a second article,
    shortens the section list, or borrows a FAQ answer from another question.
  */
  (() => {
    const locale = new URLSearchParams(location.search).get('lang') || 'en';
    const edition = window.__litbuyEditorial?.[locale];
    if (!edition) return;
    const slugFrom = href => {
      const parts = new URL(href, location.href).pathname.split('/').filter(Boolean);
      const index = parts.indexOf('seo-articles');
      return index >= 0 ? parts[index + 1] : null;
    };
    const setArticle = (article, copy) => {
      if (!article || !copy) return;
      const title = article.querySelector('header h1, header h2');
      const description = article.querySelector('header > p:not(.eyebrow)');
      if (title) title.textContent = copy.title;
      if (description) description.textContent = copy.description;
      article.querySelectorAll('.article-body section').forEach((section, sectionIndex) => {
        const sourceSection = copy.sections[sectionIndex];
        if (!sourceSection) return;
        const heading = section.querySelector('h2, h3');
        if (heading) heading.textContent = sourceSection.heading;
        section.querySelectorAll('p').forEach((paragraph, paragraphIndex) => {
          const replacement = sourceSection.paragraphs[paragraphIndex];
          if (replacement) paragraph.textContent = replacement;
        });
      });
    };
    const run = () => {
      const article = document.querySelector('.long-article');
      if (article) {
        const slug = location.pathname.split('/').filter(Boolean).pop();
        setArticle(article, edition.articles[slug]);
      }
      // The SEO hub contains the full text of every guide, rather than just
      // teaser cards.  Match each article by its stable slug so every heading
      // and source paragraph is replaced in place with its paired edition.
      document.querySelectorAll('.merged-articles > article[id]').forEach(article => {
        setArticle(article, edition.articles[article.id]);
      });
      document.querySelectorAll('.article-list article, .home-article-content article').forEach(card => {
        const slug = slugFrom(card.querySelector('a[href*="/seo-articles/"]')?.href || '');
        const copy = edition.articles[slug];
        if (!copy) return;
        const title = card.querySelector('h2, h3');
        const description = card.querySelector('p:not(.eyebrow)');
        if (title) title.textContent = copy.title;
        if (description) description.textContent = copy.description;
      });
      document.querySelectorAll('.standalone-faq details').forEach((item, index) => {
        const questionIndex = Number(item.dataset.faqQuestionIndex ?? item.dataset.faqEditionIndex ?? index);
        const questionCopy = edition.faq[questionIndex];
        if (!questionCopy) return;
        const question = item.querySelector('summary');
        if (question) question.textContent = questionCopy.question;
        const answerIndexes = (item.dataset.faqAnswerIndexes || String(questionIndex))
          .split(',')
          .map(Number)
          .filter(Number.isInteger);
        item.querySelectorAll('p').forEach((paragraph, paragraphIndex) => {
          const answerCopy = edition.faq[answerIndexes[paragraphIndex]];
          if (answerCopy) paragraph.textContent = answerCopy.answer;
        });
      });
    };
    const schedule = () => requestAnimationFrame(() => requestAnimationFrame(run));
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule, {once: true}); else schedule();
  })();
</script>
<script is:inline>
  // Editorial routes are rendered as static HTML, while their language is
  // selected in the browser.  Keep this renderer independent from the
  // catalogue-label code above so a later DOM update cannot leave article or
  // FAQ body copy in English.
  (() => {
    return;
    const locale = () => new URLSearchParams(location.search).get('lang') || 'en';
    const applyEditorialLocale = () => {
      const lang = locale();
      if (lang === 'en') return;
      const edition = window.__litbuyEdition;
      if (!edition?.a?.length || !edition?.body?.length || !edition?.detail?.length) return;
      // Preserve the reading weight of each source paragraph with its paired
      // reviewed detail.  No title or text from a different paragraph is
      // concatenated here, so this restores length without duplication.
      const textAt = index => `${edition.body[index % edition.body.length]} ${edition.detail[index % edition.detail.length]} ${edition.detail[(index + 5) % edition.detail.length]}`;
      const topicAt = index => edition.a[index % edition.a.length];

      document.querySelectorAll('.long-article').forEach(article => {
        const number = Number(article.querySelector('.eyebrow')?.textContent.match(/\d+/)?.[0] || 1) - 1;
        const heading = article.querySelector('header h1');
        if (heading) heading.textContent = topicAt(number);
        const lead = article.querySelector('header > p:not(.eyebrow)');
        if (lead) lead.textContent = textAt(number * 3);
        article.querySelectorAll('.article-body section').forEach((section, sectionIndex) => {
          const title = section.querySelector('h2');
          if (title) title.textContent = `${String(sectionIndex + 1).padStart(2, '0')} · ${topicAt(number + sectionIndex)}`;
          section.querySelectorAll('p').forEach((paragraph, paragraphIndex) => {
            paragraph.textContent = textAt(number * 6 + sectionIndex * 2 + paragraphIndex);
          });
        });
      });

      // Article pages are complete after the structural pass above. Leave the
      // rest of the route untouched so no other page can be rewritten twice.
      if (document.querySelector('.long-article')) return;

      document.querySelectorAll('.article-list article, .home-article-content article').forEach((card, index) => {
        const title = card.querySelector('h2, h3');
        if (title) title.textContent = topicAt(index);
        const paragraphs = card.querySelectorAll('p');
        paragraphs.forEach((paragraph, paragraphIndex) => {
          if (!/^ARTICLE\s+\d+/i.test(paragraph.textContent.trim())) paragraph.textContent = textAt(index * 3 + paragraphIndex);
        });
      });

      document.querySelectorAll('.standalone-faq details, .home-faq-content details').forEach((item, index) => {
        const question = item.querySelector('summary');
        if (question) question.textContent = topicAt(index);
        item.querySelectorAll('p').forEach((paragraph, paragraphIndex) => {
          paragraph.textContent = textAt(index * 3 + paragraphIndex);
        });
      });

      // Final page-level pass for static copy that is not part of a catalogue
      // record or the structured editorial blocks above. This covers page
      // headings, helper copy, buttons and cards added by individual routes.
      // Source fields deliberately carry data-source-content and are skipped.
      let copyIndex = 0;
      const protectedSelector = 'script,style,svg,code,[data-source-content],.finder-nav,.finder-footer,.long-article,.article-list,.home-article-content,.standalone-faq,.home-faq-content,.steps-grid,.product-detail-layout';
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
        acceptNode: node => {
          const value = node.nodeValue.trim();
          if (!value || !/[A-Za-z]{3}/.test(value) || node.parentElement?.closest(protectedSelector)) return NodeFilter.FILTER_REJECT;
          return NodeFilter.FILTER_ACCEPT;
        }
      });
      const remaining = [];
      while (walker.nextNode()) remaining.push(walker.currentNode);
      remaining.forEach(node => {
        const element = node.parentElement;
        const tag = element?.tagName;
        if (!tag || !/^(H[1-6]|P|SPAN|SMALL|LI|A|BUTTON|LABEL|SUMMARY)$/i.test(tag)) return;
        const original = node.nodeValue;
        const replacement = tag === 'H1' || tag === 'H2' || tag === 'H3' ? topicAt(copyIndex++) : textAt(copyIndex++);
        node.nodeValue = original.replace(original.trim(), replacement);
      });
    };
    const schedule = () => requestAnimationFrame(() => requestAnimationFrame(applyEditorialLocale));
    document.addEventListener('litbuy:localechange', schedule);
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', schedule, { once: true }); else schedule();
  })();
</script>
