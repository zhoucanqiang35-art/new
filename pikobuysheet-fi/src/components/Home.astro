---
import {articlesFor} from '../data/articles.js';
import CategoryCards from './CategoryCards.astro';
import {ui} from '../data/ui-locales.js';
import {common} from '../data/common-locales.js';
import {editorialUi} from '../data/editorial-ui.js';
const {lang,t,categories,details}=Astro.props;
const u=ui(lang);
const c=common(lang);
const editorial=editorialUi(lang);
const articles=articlesFor(lang);
const signup='https://www.pikobuy.com/register?invitedCode=KPNJVF&inviteUserId=1109716';
---
<div class="single-page">
<section class="single-hero single-hero-wide"><div class="hero-wide-inner"><div class="hero-wide-copy"><p class="v2-kicker">THE INDEPENDENT PIKOBUY GUIDE</p><h1>Pikobuy<br/><em>Spreadsheet.</em></h1><p>{t[10]} Browse finds, compare categories and learn how to inspect and ship.</p><form class="single-search" id="home-search-form" action={`/${lang}/discover/`} method="get"><input type="search" name="q" placeholder={u[0]} aria-label={u[0]}/><button type="submit"> {u[1]} ↗</button></form><span class="single-stat">8,911 exported finds · 10 research guides</span><a class="hero-explore" href="#home-discover">Explore the finds ↓</a></div></div></section>
<div class="single-jump">{[['discover',t[2]],['categories',t[3]],['w2c',t[4]],['qc',t[5]],['shipping',t[6]],['articles',t[7]],['faq',t[8]]].map(([id,label])=><a href={`#home-${id}`}>{label} ↓</a>)}</div>
<section id="home-discover" class="single-section single-discover"><div class="single-title"><div><p class="v2-kicker">01 / THE SPREADSHEET</p><h2>{t[2]} <em>finds.</em></h2><p> {u[8]}</p></div></div><div class="carousel-toolbar"><span>100 FINDS · DRAG OR SWIPE</span><div><button type="button" id="carousel-prev" aria-label="Previous products">←</button><button type="button" id="carousel-pause" aria-label="Pause automatic scrolling">Pause</button><button type="button" id="carousel-next" aria-label="Next products">→</button></div></div><div id="catalog" data-mode="featured" data-lang={lang} aria-label="Product finds carousel"></div><p class="single-note">Export: 19 October 2026. USD estimates at 1 USD = 6.6681 CNY (26 October 2026); prices and stock may change. Listing photos are not QC photos.</p><details class="single-panel" id="all-finds"><summary><span> {u[9]}</span><b>＋</b></summary><div class="panel-content"><p>Search by product name or ID, filter by category, and compare reference prices.</p><div class="filters"><input id="all-search" type="search" placeholder={u[0]}/><select id="all-category"><option value=""> {u[2]}</option>{categories.map(([slug,name])=><option value={slug}>{name}</option>)}</select><select id="all-sort"><option value="default"> {u[3]}</option><option value="low"> {u[4]}</option><option value="high"> {u[5]}</option></select></div><div id="all-catalog"></div><button id="all-more" class="btn darkbtn" type="button"> {u[6]} ↓</button></div></details></section>
<section id="home-categories" class="single-section single-category"><div class="single-title"><div><p class="v2-kicker">02 / CATEGORY DIRECTORY</p><h2>{t[3]}<em>.</em></h2><p> {u[7]}</p></div></div><CategoryCards categories={categories} lang={lang} home={true} /></section>
<section class="single-guides" aria-label="Research guides">{[['w2c',t[4]],['qc',t[5]],['shipping',t[6]]].map(([key,label],idx)=><section id={`home-${key}`} class="guide-wrapper"><details class="single-panel guide-panel" open={key === 'qc' || key === 'shipping'}><summary><span><small>0{idx+3} / {label}</small><strong>{details[key].title}</strong></span><b>＋</b></summary><div class="panel-content"><p class="panel-intro">{details[key].intro}</p><a class="inpage-link" href={`/${lang}/${key}/`}>Open full {label} page ↗</a>{details[key].sections.map(([heading,text],i)=><article class="panel-article"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{heading}</h3><p>{text}</p></div></article>)}{key==='qc'&&<p class="single-note">The current export does not include a QC photo feed.</p>}</div></details></section>)}</section>
<section id="home-articles" class="single-section single-articles"><p class="v2-kicker">06 / {t[7]}</p><h2> {c[5]}</h2><p> {c[6]}</p>{articles.some(a=>!a.translated)&&<p class="single-note"> {c[14]}</p>}<div class="article-accordions">{articles.map((a,i)=><details class="single-panel article-panel"><summary><span><small>{editorial[3]} {String(i+1).padStart(2,'0')}</small><strong>{a.title}</strong></span><b>＋</b></summary><div class="panel-content"><p class="panel-intro">{a.deck}</p><a class="inpage-link" href={`/${lang}/articles/${a.slug}/`}> {c[8]} ↗</a>{a.sections.map(section=><article class="full-article"><h3>{section.title}</h3>{section.paragraphs.map(p=><p>{p}</p>)}{section.bullets&&<ul>{section.bullets.map(b=><li>{b}</li>)}</ul>}</article>)}</div></details>)}</div></section>
<section id="home-faq" class="single-section single-faq"><p class="v2-kicker">07 / {t[8]}</p><h2> {c[7]}</h2><p>{details.faq.intro}</p><div class="faq-accordions">{details.faq.sections.map(([q,a])=><details><summary>{q}<span>＋</span></summary><p>{a}</p></details>)}</div></section>
<section class="single-end"><p class="v2-kicker">THE FINDS EDIT</p><h2>Better finds start<br/><em>with better questions.</em></h2><a class="single-end-signup" href={signup} target="_blank" rel="sponsored noopener noreferrer">{t[12]} ↗</a><a href="#top"> {c[13]} ↑</a></section>
</div>
