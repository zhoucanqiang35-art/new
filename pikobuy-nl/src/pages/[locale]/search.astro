---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { searchProducts, type Product } from '../../lib/findspreadsheet';
import { messages, route, validLocale } from '../../lib/i18n';
const locale=validLocale(Astro.params.locale); const t=messages[locale]; const q=(Astro.url.searchParams.get('q') ?? '').slice(0,120); const sort=Astro.url.searchParams.get('sort') ?? 'new';
let products: Product[]=[]; let failed=false; if(q) try { products=await searchProducts(q,sort); } catch { failed=true; }
---
<BaseLayout locale={locale} title={`${t.searchTitle} | ${t.hero}`} description={t.searchTitle}>
 <section class="page-head"><p class="eyebrow">{t.source}</p><h1>{t.searchTitle}</h1><form class="search on-light" action={route(locale,'search')}><input name="q" value={q} placeholder={t.placeholder} required /><button>{t.search}</button></form>{q && <div class="chips"><a class:list={[{active:sort==='new'}]} href={`${route(locale,'search')}?q=${encodeURIComponent(q)}&sort=new`}>Latest</a><a class:list={[{active:sort==='click'}]} href={`${route(locale,'search')}?q=${encodeURIComponent(q)}&sort=click`}>Popular</a><a class:list={[{active:sort==='price'}]} href={`${route(locale,'search')}?q=${encodeURIComponent(q)}&sort=price`}>Price</a></div>}</section>
 {q && (failed ? <p class="notice">{t.noResults}</p> : <ProductGrid products={products} locale={locale} label={q} />)}
</BaseLayout>
