---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { productsByCategory, type Product } from '../../lib/findspreadsheet';
import { messages, route, validLocale } from '../../lib/i18n';
const locale = validLocale(Astro.params.locale); const t = messages[locale];
const categories = ['shoes','hoodies-sweaters','t-shirts','jackets','pants-shorts','accessories','jersey','electronics','other-stuff'];
const current = categories.includes(Astro.url.searchParams.get('category') ?? '') ? Astro.url.searchParams.get('category')! : 'shoes';
let products: Product[]=[]; let failed=false; try { products=await productsByCategory(current); } catch { failed=true; }
---
<BaseLayout locale={locale} title={`${t.categories} | ${t.hero}`} description={t.categoryTitle}>
 <section class="page-head"><p class="eyebrow">{t.source}</p><h1>{t.categoryTitle}</h1><div class="chips">{categories.map((category) => <a class:list={[{active: current === category}]} href={`${route(locale,'categories')}?category=${category}`}>{category.replaceAll('-',' ')}</a>)}</div></section>
 {failed ? <p class="notice">{t.noResults}</p> : <ProductGrid products={products} locale={locale} label={current.replaceAll('-',' ')} />}
</BaseLayout>
