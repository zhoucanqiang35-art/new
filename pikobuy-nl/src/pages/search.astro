---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sourceSearchUrl } from '../lib/findspreadsheet';
const query = Astro.url.searchParams.get('q')?.trim() ?? '';
const sourceUrl = query ? sourceSearchUrl(query) : '/finds';
---
<BaseLayout title="Search PikoBuy Finds | PikoBuy Spreadsheet" description="Search product records through the FindSpreadsheet source catalogue.">
  <section class="page-intro">
    <p class="eyebrow">SOURCE-LED SEARCH</p>
    <h1>{query ? `Search: ${query}` : 'Search product finds'}</h1>
    <p>Search remains transparent: the source catalogue is FindSpreadsheet. This project does not keep a second, stale copy of product data.</p>
    {query && <a class="button" href={sourceUrl}>Open results on FindSpreadsheet</a>}
  </section>
</BaseLayout>
