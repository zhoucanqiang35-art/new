---
import '../styles.css';
import { languageNames, locales, messages, route, type Locale } from '../lib/i18n';

interface Props { locale: Locale; title: string; description: string; }
const { locale, title, description } = Astro.props;
const t = messages[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const rest = Astro.url.pathname.replace(new RegExp(`^/${locale}`), '') || '/';
const query = Astro.url.search;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="https://www.pikobuy.com/images/common/pikobuy-icon-192.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={route(locale)} aria-label="PikoBuy Spreadsheet home">
        <img src="https://www.pikobuy.com/images/header/pikobuy-logo-figma.png" alt="PikoBuy" width="158" height="38" />
        <span>Spreadsheet</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={route(locale)}>{t.home}</a>
        <a href={route(locale, 'categories')}>{t.categories}</a>
        <a href={route(locale, 'guides')}>{t.guides}</a>
        <a href={route(locale, 'faq')}>{t.faq}</a>
      </nav>
      <details class="language"><summary>{t.language} · {locale.toUpperCase()}</summary><div>{locales.map((target) => <a href={`/${target}${rest}${query}`}>{languageNames[target]}</a>)}</div></details>
    </header>
    <main><slot /></main>
    <footer>
      <p><strong>PikoBuy Spreadsheet</strong> — {t.independent}</p>
      <p>{t.source}. {t.research}</p>
    </footer>
  </body>
</html>
